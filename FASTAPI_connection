pipeline {
    agent any
    stages {
        stage('Prepare & Download (on Jenkins)') {
            steps {
                script {
                    checkout scm 
                    
                    // 1. Ensure the requirements file exists in the correct folder
                    sh 'echo "fastapi\nuvicorn\nsqlalchemy\npsycopg[binary]" > backend-api/requirements.txt'
                    
                    // 2. Create the folder locally before downloading
                    sh 'mkdir -p dependencies'
                    
                    // 3. Download to the local folder
                    sh "pip3 download -r backend-api/requirements.txt -d ./dependencies"
                }
            }
        }

        stage('Deploy to Private Backend') {
            steps {
                sshagent(['AWS_SSH_KEY']) {
                    sh """
                        # 1. Prepare directory structure on private server
                        ssh -o StrictHostKeyChecking=no ec2-user@10.0.3.18 'mkdir -p ~/fruits-veg_market/dependencies'
                        
                        # 2. Push dependencies first
                        scp -o StrictHostKeyChecking=no -r ./dependencies/* ec2-user@10.0.3.18:~/fruits-veg_market/dependencies/
                        
                        # 3. Push code
                        scp -o StrictHostKeyChecking=no -r ./backend-api/* ec2-user@10.0.3.18:~/fruits-veg_market/backend-api/
                        
                        # 4. Install and Start
                        ssh -o StrictHostKeyChecking=no ec2-user@10.0.3.18 '
                            cd ~/fruits-veg_market/backend-api
                            sudo yum install python3-pip -y
                            
                            # Install from the folder one level up
                            pip3 install --no-index --find-links=../dependencies -r requirements.txt
                            
                            pkill uvicorn || true
                            
                            # STARTING APP: 'main' is filename, 'app' is FastAPI instance
                            nohup python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 > ../fastapi.log 2>&1 &
                        '
                    """
                }
            }
        }
    }
}